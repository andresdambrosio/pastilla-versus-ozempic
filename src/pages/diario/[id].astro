---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DatosDelDia from '../../components/DatosDelDia.astro';
import { diaDelDesafio, fechaCorta, fechaLarga, getDiario } from '../../lib/stats';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const dias = await getDiario();
  return dias.map((dia, i) => ({
    params: { id: dia.id },
    props: { dia, anterior: dias[i - 1], siguiente: dias[i + 1] },
  }));
}

const { dia, anterior, siguiente } = Astro.props;
const { Content } = await render(dia);
const vacio = !dia.body?.trim();
const n = diaDelDesafio(dia.data.fecha) + 1;
---

<Base titulo={`Día ${n}`}>
  <article class="prosa">
    <span class="etiqueta">Día {n}</span>
    <h1>{fechaLarga(dia.data.fecha)}</h1>
    <div class="tarjeta"><DatosDelDia dia={dia} /></div>
    {vacio ? <p class="muted">Solo pesaje.</p> : <Content />}
    {
      dia.data.reglas.length > 0 && (
        <aside class="tarjeta reglas">
          <span class="etiqueta">Al Reglamento</span>
          <ul>
            {dia.data.reglas.map((r) => <li>{r}</li>)}
          </ul>
        </aside>
      )
    }
  </article>
  <nav class="pasos">
    {anterior ? <a href={url(`/diario/${anterior.id}/`)}>← {fechaCorta(anterior.data.fecha)}</a> : <span />}
    {siguiente && <a href={url(`/diario/${siguiente.id}/`)}>{fechaCorta(siguiente.data.fecha)} →</a>}
  </nav>
</Base>

<style>
  h1 { margin-top: 8px; }
  h1::first-letter { text-transform: uppercase; }
  .tarjeta { margin: 16px 0 24px; }
  .reglas ul { margin: 8px 0 0; padding-left: 20px; }
  .pasos { display: flex; justify-content: space-between; margin-top: 32px; }
</style>
