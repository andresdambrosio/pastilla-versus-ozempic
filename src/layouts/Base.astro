---
import '../styles/global.css';

interface Props {
  titulo?: string;
  descripcion?: string;
}

const { titulo, descripcion = 'Un tipo, una balanza y la curva promedio de Ozempic. ¿Se le puede ganar a la pastilla con esfuerzo?' } = Astro.props;
const tituloCompleto = titulo ? `${titulo} · Pastilla vs Ozempic` : 'Pastilla vs Ozempic';
const ruta = Astro.url.pathname;

const nav = [
  { href: '/', label: 'Carrera' },
  { href: '/escritos/', label: 'Escritos' },
  { href: '/diario/', label: 'Diario' },
  { href: '/datos/', label: 'Datos' },
  { href: '/reglamento/', label: 'Reglamento' },
];
const activo = (href: string) => (href === '/' ? ruta === '/' : ruta.startsWith(href));
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Aplica el tema elegido antes de pintar, para que no parpadee.
      try {
        const t = localStorage.getItem('tema');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="cabecera">
      <div class="contenedor fila">
        <a href="/" class="marca">Pastilla <span>vs</span> Ozempic</a>
        <nav>
          {nav.map((n) => <a href={n.href} aria-current={activo(n.href) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        <button class="tema" type="button" aria-label="Cambiar tema" title="Cambiar tema">
          <svg class="luna" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" />
          </svg>
          <svg class="sol" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
          </svg>
        </button>
      </div>
    </header>
    <main class="contenedor">
      <slot />
    </main>
    <footer class="contenedor pie muted chico">
      <p>
        Esto es un desafío personal, no un consejo médico ni una campaña contra ningún medicamento. Si estás pensando
        en bajar de peso, hablalo con tu médico.
      </p>
      <p><a href="/fuentes/">Fuentes y cálculos</a></p>
    </footer>
  </body>
</html>

<script>
  const raiz = document.documentElement;
  const boton = document.querySelector<HTMLButtonElement>('.tema')!;
  const sistemaOscuro = matchMedia('(prefers-color-scheme: dark)');
  const esOscuro = () => (raiz.dataset.theme ? raiz.dataset.theme === 'dark' : sistemaOscuro.matches);

  const actualizar = () => {
    const etiqueta = esOscuro() ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro';
    boton.setAttribute('aria-label', etiqueta);
    boton.title = etiqueta;
  };

  boton.addEventListener('click', () => {
    const nuevo = esOscuro() ? 'light' : 'dark';
    raiz.dataset.theme = nuevo;
    try {
      localStorage.setItem('tema', nuevo);
    } catch {}
    actualizar();
  });
  sistemaOscuro.addEventListener('change', actualizar);
  actualizar();
</script>

<style>
  .cabecera {
    border-bottom: 1px solid var(--border);
    background: var(--surface);
    margin-bottom: 32px;
  }
  .fila {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 20px;
    padding-top: 14px;
    padding-bottom: 14px;
  }
  .marca {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--text);
    text-decoration: none;
  }
  .marca span { color: var(--text-3); font-size: 1.1rem; }
  nav { display: flex; flex-wrap: wrap; gap: 4px 16px; margin-left: auto; }
  .tema {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 99px;
    background: var(--bg);
    color: var(--text-2);
    cursor: pointer;
  }
  /* En celular: nombre y botón arriba, menú abajo a todo el ancho. */
  @media (max-width: 640px) {
    .tema { order: 1; margin-left: auto; }
    nav { order: 2; width: 100%; margin-left: 0; }
  }
  .tema:hover { color: var(--text); border-color: var(--text-3); }
  .tema svg { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .tema .luna { fill: currentColor; stroke: none; }
  /* Se muestra el ícono del modo al que se cambia: luna en claro, sol en oscuro. */
  .sol { display: none; }
  :global(:root[data-theme='dark']) .sol { display: block; }
  :global(:root[data-theme='dark']) .luna { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .sol { display: block; }
    :global(:root:not([data-theme='light'])) .luna { display: none; }
  }
  nav a { color: var(--text-2); text-decoration: none; font-size: 0.95rem; font-weight: 500; }
  nav a:hover { color: var(--text); }
  nav a[aria-current='page'] { color: var(--text); text-decoration: underline; text-decoration-thickness: 2px; }
  .pie { margin-top: 64px; padding-top: 16px; padding-bottom: 32px; border-top: 1px solid var(--border); }
</style>
