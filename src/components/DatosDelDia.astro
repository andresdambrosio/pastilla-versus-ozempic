---
import type { Dia } from '../lib/stats';
import { horas, kg, pasos, textoEjercicio } from '../lib/stats';

interface Props { dia: Dia }
const { pesoKg, suenoMin, pasos: p, aguaLitros, ejercicios } = Astro.props.dia.data;

const datos = [
  pesoKg !== undefined && { label: 'Peso', valor: `${kg(pesoKg)} kg` },
  suenoMin !== undefined && { label: 'Sueño', valor: horas(suenoMin) },
  p !== undefined && { label: 'Pasos', valor: pasos(p) },
  aguaLitros !== undefined && { label: 'Agua', valor: `${kg(aguaLitros)} l` },
  ejercicios.length > 0 && { label: 'Ejercicio', valor: ejercicios.map(textoEjercicio).join(' · ') },
].filter(Boolean) as { label: string; valor: string }[];
---

<dl class="datos">
  {datos.map((d) => (
    <div>
      <dt>{d.label}</dt>
      <dd>{d.valor}</dd>
    </div>
  ))}
</dl>

<style>
  .datos { display: flex; flex-wrap: wrap; gap: 8px 24px; margin: 0; }
  dt { font-size: 0.75rem; color: var(--text-3); text-transform: uppercase; letter-spacing: 0.06em; font-weight: 600; }
  dd { margin: 0; font-weight: 600; font-variant-numeric: tabular-nums; }
</style>
